{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Monochrome GitHub profile configuration",
  "type": "object",
  "required": ["github", "blog", "profile", "theme", "motion", "effects", "layout"],
  "properties": {
    "github": {
      "type": "object",
      "required": ["username", "featured", "list"],
      "properties": {
        "username": { "type": "string", "minLength": 1 },
        "exclude": { "type": "array", "items": { "type": "string" } },
        "featured": { "type": "integer", "minimum": 2, "maximum": 8 },
        "list": { "type": "integer", "minimum": 0, "maximum": 20 }
      }
    },
    "blog": {
      "type": "object",
      "required": ["url", "limit"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "limit": { "type": "integer", "minimum": 0, "maximum": 10 }
      }
    },
    "profile": {
      "type": "object",
      "required": ["name", "handle", "role", "intro", "status", "focus", "state", "links"],
      "properties": {
        "name": { "type": "string" },
        "handle": { "type": "string" },
        "role": { "type": "string" },
        "intro": { "type": "string" },
        "status": { "type": "string" },
        "focus": { "type": "string" },
        "state": { "type": "string" },
        "links": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": ["label", "url"],
            "properties": { "label": { "type": "string" }, "url": { "type": "string", "format": "uri" } }
          }
        }
      }
    },
    "theme": {
      "type": "object",
      "required": ["page", "panel", "well", "text1", "text2", "text3", "line", "lineFaint", "accent", "selected", "ok", "warn", "fail", "languageFallback", "ditherPalette"],
      "properties": {
        "ditherPalette": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
        }
      },
      "additionalProperties": { "type": "string" }
    },
    "motion": {
      "type": "object",
      "required": ["enabled", "speed", "sceneDuration", "sceneFps", "pendingDuration"],
      "properties": {
        "enabled": { "type": "boolean" },
        "speed": { "type": "number", "exclusiveMinimum": 0 },
        "sceneDuration": { "type": "number", "exclusiveMinimum": 0, "maximum": 30 },
        "sceneFps": { "type": "integer", "minimum": 1, "maximum": 60 },
        "pendingDuration": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "effects": {
      "type": "object",
      "required": ["dither", "ditherScale", "animatedScene", "pendingMark"],
      "properties": {
        "dither": { "type": "boolean" },
        "ditherScale": { "type": "integer", "minimum": 2, "maximum": 8 },
        "animatedScene": { "type": "boolean" },
        "pendingMark": { "type": "boolean" }
      }
    },
    "layout": {
      "type": "object",
      "required": ["width", "showStats", "showUpdatedAt"],
      "properties": {
        "width": { "type": "integer", "minimum": 880, "maximum": 1200 },
        "showStats": { "type": "boolean" },
        "showUpdatedAt": { "type": "boolean" }
      }
    },
    "rank": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "country": { "type": "string", "pattern": "^[A-Za-z]{2}$" }
      }
    }
  }
}
